PORT=4000
# Required in production; use a random value of at least 32 characters.
# Example: openssl rand -base64 48
# CAMPUS_BITES_JWT_SECRET=
# Super Admin (created/updated on every `npm run seed`).
# Email defaults to adityakumarkaushal07@gmail.com when unset; override freely.
SUPER_ADMIN_EMAIL=adityakumarkaushal07@gmail.com
# Required when running `npm run seed`; use at least 12 characters.
SUPER_ADMIN_PASSWORD=Kaushal7aditya
# Legacy names, still honoured as a fallback:
# CAMPUS_BITES_SUPER_ADMIN_EMAIL=
# CAMPUS_BITES_SUPER_ADMIN_PASSWORD=
# CAMPUS_BITES_DB_PATH=./campus-bites.sqlite3

# Phase 6B: leave unset so an admin confirms every restaurant payout manually.
# Set to true only for demos where payouts should auto-settle.
CAMPUS_BITES_AUTO_PAYOUT=false
