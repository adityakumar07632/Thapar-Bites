# Environment variables for Campus Bites (production example)
# Copy to .env and set secure values for deployment.

# Node environment
NODE_ENV=production

# Port the API should listen on (platform will usually provide this)
PORT=4000

# Strong secret used to sign JWTs. MUST be set in production.
JWT_SECRET=change-me-to-a-strong-secret

# SQLite DB path; override if you mount a different path in production.
CAMPUS_BITES_DB_PATH=apps/campus-bites.sqlite3

# Comma-separated allowed CORS origins for the API (include deployed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
